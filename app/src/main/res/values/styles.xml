<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JediChatKeyboard" parent="Theme.MaterialComponents.DayNight.DarkActionBar"/>

    <style name="KeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SpecialKeyStyle">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/key_special_bg</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
